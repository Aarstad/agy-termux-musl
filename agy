#!/data/data/com.termux/files/usr/bin/bash
# Run the musl-patched Antigravity CLI on Termux.
#
# Starts the bionic-side DNS proxy (musl has no /etc/resolv.conf on Android, so
# DNS inside the process is dead) and points agy at it, then runs the binary.
#
#   AGY_NO_PROXY=1   use ambient proxy settings instead of starting one
#   AGY_NO_REPAIR=1  report a replaced agy.bin instead of repatching it
#   AGY_ALLOW_UPDATE=1  let agy's background auto-updater run (off by default)
#
# Not "#!/usr/bin/env bash": Android has no /usr/bin/env.
set -euo pipefail

# Resolve through a symlink: ~/.local/bin/agy points here, but the binary,
# shim and proxy all live beside this script in the repo.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  link="$(readlink "$SELF")"
  case "$link" in /*) SELF="$link" ;; *) SELF="$(dirname "$SELF")/$link" ;; esac
done
HERE="$(cd "$(dirname "$SELF")" && pwd -P)"
BIN="$HERE/agy.bin"
PROXY="$HERE/dns-proxy"

LIBDIR="$HERE/lib"

[ -x "$BIN" ] || { echo "agy: $BIN is missing" >&2; exit 1; }
[ -e "$LIBDIR/libagyshim.so" ] || { echo "agy: shim missing from $LIBDIR" >&2; exit 1; }

: "${PREFIX:=/data/data/com.termux/files/usr}"
LOADER="$LIBDIR/ld-musl-aarch64.so.1"

# Read PT_INTERP out of the ELF. patchelf moves it into a segment of its own at
# the end of the file, so there is no fixed place to look for it.
elf_interp() {
  local f="$1" phoff phentsize phnum words i base lo hi off sz
  [ "$(od -An -tx1 -N4 "$f" | tr -d ' ')" = "7f454c46" ] || return 1
  phoff="$(od -An -tu8 -j32 -N8 -v "$f" | tr -d ' ')"
  read -r phentsize phnum < <(od -An -tu2 -j54 -N4 -v "$f")
  words=($(od -An -tu4 -j"$phoff" -N"$((phentsize * phnum))" -v "$f"))
  for ((i = 0; i < phnum; i++)); do
    base=$((i * phentsize / 4))
    [ "${words[base]}" = 3 ] || continue          # PT_INTERP
    lo="${words[base + 2]}"; hi="${words[base + 3]}"
    off=$((hi * 4294967296 + lo)); sz="${words[base + 8]}"
    dd if="$f" bs=1 skip="$off" count="$sz" 2>/dev/null | tr -d "\0"
    return 0
  done
  return 1
}

# agy updates itself in the background: it renames agy.bin to
# agy.bin.<nanos>.old and writes a stock Google build in its place, undoing
# every patch install.sh applied. That build asks for glibc's loader, which
# Android does not have, and the only thing the user sees is "cannot execute:
# required file not found". Catch it here, where the cause can be named.
if [ "$(elf_interp "$BIN" || true)" != "$LOADER" ]; then
  echo "agy: agy.bin is not linked against musl -- the auto-updater has" >&2
  echo "     replaced it with a stock build." >&2
  if [ -n "${AGY_NO_REPAIR:-}" ] || [ ! -x "$HERE/install.sh" ]; then
    echo "     Repatch it with: $HERE/install.sh --from-binary $BIN" >&2
    exit 1
  fi
  echo "agy: re-applying the patches to the new version..." >&2
  # install.sh verifies by running its own build now, so it no longer re-enters
  # this script; AGY_NO_REPAIR stays as a stop against any path that does. If
  # the patching fails, install.sh leaves agy.bin untouched and exits non-zero.
  AGY_NO_REPAIR=1 "$HERE/install.sh" --from-binary "$BIN" >&2 \
    || { echo "agy: could not repatch agy.bin" >&2; exit 1; }
fi

# ...and stop it happening again. agy checks this before spawning the updater:
#
#   auto_updater.go:247  Auto-update disabled via environment variable
#                        AGY_CLI_DISABLE_AUTO_UPDATE
#
# The value must be exactly "true". The binary compares four bytes against
# 0x65757274 and ignores everything else, "1" included, without saying so.
# Update deliberately instead: ./agy-update, or AGY_ALLOW_UPDATE=1 for one run.
if [ -z "${AGY_ALLOW_UPDATE:-}" ]; then
  export AGY_CLI_DISABLE_AUTO_UPDATE="${AGY_CLI_DISABLE_AUTO_UPDATE:-true}"
fi

PROXY_PID=""
cleanup() { [ -n "${PROXY_PID:-}" ] && kill "$PROXY_PID" 2>/dev/null; return 0; }
trap cleanup EXIT HUP INT TERM

if [ -z "${AGY_NO_PROXY:-}" ]; then
  if [ -n "${HTTP_PROXY:-${http_proxy:-}}" ]; then
    : # Ambient proxy already configured
  elif nc -z 127.0.0.1 18080 2>/dev/null; then
    export http_proxy="http://127.0.0.1:18080"
    export https_proxy="$http_proxy"
    export HTTP_PROXY="$http_proxy"
    export HTTPS_PROXY="$http_proxy"
    export all_proxy="$http_proxy"
  elif [ -x "$PROXY" ]; then
    # The proxy prints its port on stdout then serves until killed.
    FIFO="$(mktemp -u "${TMPDIR:-/data/data/com.termux/files/usr/tmp}/agy-proxy.XXXXXX")"
    if mkfifo "$FIFO" 2>/dev/null; then
      "$PROXY" > "$FIFO" 2>/dev/null &
      PROXY_PID=$!
      read -r -t 15 PORT < "$FIFO" || true
      rm -f "$FIFO"
      if [ -n "${PORT:-}" ] && kill -0 "$PROXY_PID" 2>/dev/null; then
        export http_proxy="http://127.0.0.1:$PORT"
        export https_proxy="$http_proxy"
        export HTTP_PROXY="$http_proxy"
        export HTTPS_PROXY="$http_proxy"
        export all_proxy="$http_proxy"
      else
        PROXY_PID=""
        echo "agy: DNS proxy did not start; network will not work" >&2
      fi
    fi
  fi
fi

# Go's crypto/x509 looks for a CA bundle at the standard Linux paths
# (/etc/ssl/certs/ca-certificates.crt and friends). Android has none of them, so
# every TLS verification fails with "certificate signed by unknown authority" --
# including the OAuth token-exchange POST, which makes login impossible. Termux
# ships the bundle at $PREFIX/etc/tls/cert.pem; point Go at it.
if [ -z "${SSL_CERT_FILE:-}" ] && [ -r "$PREFIX/etc/tls/cert.pem" ]; then
  export SSL_CERT_FILE="$PREFIX/etc/tls/cert.pem"
fi
[ -n "${SSL_CERT_DIR:-}" ] || export SSL_CERT_DIR="$PREFIX/etc/tls"

# Termux preloads a bionic library that a musl process cannot relocate.
unset LD_PRELOAD

# Deliberately not exec: the EXIT trap is what stops the proxy, and exec would
# replace this shell and orphan it. One idle shell buys deterministic cleanup.
"$BIN" "$@"
rc=$?
cleanup
exit "$rc"
